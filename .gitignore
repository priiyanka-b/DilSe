data/processed/mmash_hrv.csv
# Per-person plots and parameters of real PMData participants
outputs/wearables/
outputs/recipe/per_person_dynamics.csv
# Saliency maps (51 MB; regenerate with saliency.py)
outputs/saliency/*.npy

